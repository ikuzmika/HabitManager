<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:HabitManager.App.ViewModels"
    xmlns:controls="using:HabitManager.App.Controls"
    x:Class="HabitManager.App.Views.HabitCreatePage"
    x:DataType="viewModels:HabitCreateViewModel"
    Title="New habit">
    
    <ContentPage.ToolbarItems>
        <controls:ThemeToolbarItem />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="12">

            <Label Text="Name" />

            <Entry
                Text="{Binding Name, Mode=TwoWay}"
                Placeholder="Enter the name of the habit" />

            <Label Text="Description" />

            <Editor
                Text="{Binding Description, Mode=TwoWay}"
                Placeholder="Enter the description of the habit"
                AutoSize="TextChanges"
                MinimumHeightRequest="100" />

            <Label
                Text="Frequency"
                FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="12">
                <Label
                    Text="Every day"
                    VerticalOptions="Center" />

                <Switch
                    IsToggled="{Binding Schedule.IsDaily, Mode=TwoWay}" />
            </HorizontalStackLayout>

            <VerticalStackLayout
                IsVisible="{Binding Schedule.IsSelectedDays}"
                Spacing="4">

                <Label Text="Select the days:" />

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Schedule.Days}">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ScheduleDayViewModel">

                            <HorizontalStackLayout Spacing="8">
                                <CheckBox
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                <Label
                                    Text="{Binding Name}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>
            </VerticalStackLayout>
            
            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red" />

            <Button
                Text="Create"
                Clicked="OnCreateClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>