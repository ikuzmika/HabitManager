<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:HabitManager.App.ViewModels"
    xmlns:controls="using:HabitManager.App.Controls"
    x:Class="HabitManager.App.Views.HabitListPage"
    x:DataType="viewModels:HabitListViewModel"
    Title="MyHabits">
    
    <ContentPage.ToolbarItems>
        <controls:ThemeToolbarItem />
    </ContentPage.ToolbarItems>

    <Grid
        x:Name="PageLayout"
        Padding="20"
        RowDefinitions="Auto,*"
        RowSpacing="20"
        SizeChanged="OnPageLayoutSizeChanged">

        <Grid
            x:Name="HeaderGrid"
            ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="16"
            RowSpacing="12">

            <Label
                x:Name="HeaderTitle"
                Text="demo-user-1 habits"
                FontSize="26"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <HorizontalStackLayout
                x:Name="HeaderActions"
                Grid.Column="1"
                Spacing="8"
                HorizontalOptions="End"
                VerticalOptions="Center">

                <Button
                    Text="Add habit"
                    Clicked="OnAddHabitClicked" />

                <Button
                    Text="Archive"
                    Clicked="OnArchivedHabitsClicked" />

            </HorizontalStackLayout>

        </Grid>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Habits}"
            SelectionMode="Single"
            SelectionChanged="OnHabitSelected"
            EmptyView="There are no active habits.">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    x:Name="HabitsGridLayout"
                    Orientation="Vertical"
                    Span="1"
                    HorizontalItemSpacing="16"
                    VerticalItemSpacing="16" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate
                    x:DataType="viewModels:HabitListItemViewModel">

                    <Border
                        Padding="18"
                        MinimumHeightRequest="150"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E3DFED,
                                                 Dark=#45404F}"
                        BackgroundColor="{AppThemeBinding Light=#F8F6FC,
                                                          Dark=#25222D}">

                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer
                                PointerEntered="OnHabitPointerEntered"
                                PointerExited="OnHabitPointerExited" />
                        </Border.GestureRecognizers>
                        
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Grid
                            RowDefinitions="Auto,*,Auto"
                            RowSpacing="10">

                            <Label
                                Text="{Binding Name}"
                                FontSize="20"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                MaxLines="2" />

                            <Label
                                Grid.Row="1"
                                Text="{Binding Description}"
                                FontSize="14"
                                LineBreakMode="TailTruncation"
                                MaxLines="3"
                                TextColor="{AppThemeBinding Light=#625C70,
                                                            Dark=#C6C0D1}" />

                            <Label
                                Grid.Row="2"
                                Text="{Binding CompletionText}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#51416D,
                                                            Dark=#C7B5ED}" />

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>